diff --git a/Cython/Compiler/Scanning.py b/Cython/Compiler/Scanning.py
index 54e352cab..53e68feac 100644
--- a/Cython/Compiler/Scanning.py
+++ b/Cython/Compiler/Scanning.py
@@ -6,7 +6,7 @@
 
 import cython
 
-cython.declare(make_lexicon=object, lexicon=object,
+cython.declare(make_lexicon=object, lexicon=object, oxython_lexicon=object,
                print_function=object, error=object, warning=object,
                os=object, platform=object, Path=object)
 
@@ -30,15 +30,37 @@ scanner_debug_flags = 0
 scanner_dump_file = None
 
 lexicon = None
+oxython_lexicon = None
 
 
-def get_lexicon():
-    global lexicon
+def get_lexicon(oxython=False):
+    global lexicon, oxython_lexicon
+    if oxython:
+        if not oxython_lexicon:
+            oxython_lexicon = make_lexicon(oxython=True)
+        return oxython_lexicon
     if not lexicon:
         lexicon = make_lexicon()
     return lexicon
 
 
+# oxython file extensions and the Cython extension each one stands for
+oxython_extensions = {'.oxy': '.pyx', '.oxd': '.pxd', '.oxi': '.pxi'}
+
+
+def source_is_oxython(source_desc):
+    """
+    oxython syntax is used for .oxy, .oxd and .oxi files.  The environment
+    variable CYTHON_FORCE_OXYTHON applies it to every Cython file, which lets
+    the upstream test suite check that existing code still parses.
+    """
+    if getattr(source_desc, 'in_utility_code', False) or source_desc.is_python_file():
+        return False
+    if source_desc.is_oxython_file:
+        return True
+    return bool(os.environ.get('CYTHON_FORCE_OXYTHON'))
+
+
 #------------------------------------------------------------------
 
 py_reserved_words = [
@@ -129,6 +151,7 @@ class SourceDescriptor:
     in_utility_code = False
 
     _file_type = 'pyx'
+    is_oxython_file = False
 
     _escaped_description = None
     _cmp_name = ''
@@ -137,6 +160,9 @@ class SourceDescriptor:
 
     def set_file_type_from_name(self, filename):
         name, ext = os.path.splitext(filename)
+        # oxython files: .oxy (module), .oxd (declarations), .oxi (include)
+        self.is_oxython_file = ext in oxython_extensions
+        ext = oxython_extensions.get(ext, ext)
         self._file_type = ext in ('.pyx', '.pxd', '.py') and ext[1:] or 'pyx'
 
     def is_cython_file(self):
@@ -316,7 +342,11 @@ class PyrexScanner(Scanner):
 
     def __init__(self, file, filename, parent_scanner=None,
                  scope=None, context=None, source_encoding=None, parse_comments=True, initial_pos=None):
-        Scanner.__init__(self, get_lexicon(), file, filename, initial_pos)
+        if parent_scanner is not None and parent_scanner.oxython:
+            self.oxython = True
+        else:
+            self.oxython = source_is_oxython(filename)
+        Scanner.__init__(self, get_lexicon(self.oxython), file, filename, initial_pos)
 
         if filename.is_python_file():
             self.in_python_file = True
