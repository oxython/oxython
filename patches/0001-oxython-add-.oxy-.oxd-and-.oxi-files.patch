index 040bcbe7f..916fc1699 100644
--- a/Cython/Compiler/Scanning.pxd
+++ b/Cython/Compiler/Scanning.pxd
@@ -4,7 +4,7 @@ from ..Plex.Scanners cimport Scanner
 
 cdef str any_string_prefix, IDENT
 
-cdef get_lexicon()
+cdef get_lexicon(bint oxython=*)
 cdef initial_compile_time_env()
 
 ## methods commented with '##' out are used by Parsing.py when compiled.
@@ -26,6 +26,7 @@ cdef class PyrexScanner(Scanner):
     cdef public bint compile_time_expr
     cdef public bint parse_comments
