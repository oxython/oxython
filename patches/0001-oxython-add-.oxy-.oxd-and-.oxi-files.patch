@@ -603,6 +603,8 @@ class DependencyTree:
         filename_root, filename_ext = os.path.splitext(filename)
         if filename_ext in ('.pyx', '.py') and path_exists(filename_root + '.pxd'):
             pxd_list = [filename_root + '.pxd']
+        elif filename_ext == '.oxy' and path_exists(filename_root + '.oxd'):
+            pxd_list = [filename_root + '.oxd']
         else:
             pxd_list = []
         # Cimports generates all possible combinations package.module
@@ -775,7 +777,7 @@ def create_extension_list(patterns, exclude=None, ctx=None, aliases=None, quiet=
             ext_language = language
         elif isinstance(pattern, extension_classes):
             cython_sources = [s for s in pattern.sources
-                              if os.path.splitext(s)[1] in ('.py', '.pyx')]
+                              if os.path.splitext(s)[1] in ('.py', '.pyx', '.oxy')]
             template = pattern
             name = template.name
             base = DistutilsInfo(exn=template)
@@ -1032,7 +1034,7 @@ def cythonize(module_list, exclude=None, nthreads=0, aliases=None, quiet=False,
 
         cy_sources = [
             source for source in m.sources
-            if os.path.splitext(source)[1] in ('.pyx', '.py')]
+            if os.path.splitext(source)[1] in ('.pyx', '.py', '.oxy')]
         if len(cy_sources) == 1:
             # normal "special" case: believe the Extension module name to allow user overrides
             full_module_name = m.name
@@ -1053,7 +1055,7 @@ def cythonize(module_list, exclude=None, nthreads=0, aliases=None, quiet=False,
         new_sources = []
         for source in m.sources:
             base, ext = os.path.splitext(source)
-            if ext in ('.pyx', '.py'):
+            if ext in ('.pyx', '.py', '.oxy'):
                 c_file = base + ('.cpp' if m.language == 'c++' or np_pythran else '.c')
 
                 # setup for out of place build directory if enabled
