From: Rin Arakaki <rnarkkx@gmail.com>
Date: Mon, 12 Oct 2026 07:34:39 +0000
Subject: [PATCH] oxython: add true, false and typed numeric literals


diff --git a/Cython/Compiler/ExprNodes.py b/Cython/Compiler/ExprNodes.py
index e9e6aacb1..166e7a5ed 100644
--- a/Cython/Compiler/ExprNodes.py
+++ b/Cython/Compiler/ExprNodes.py
@@ -1750,6 +1750,29 @@ class FloatNode(ConstNode):
             self.result_code = c_value
 
 
+class TypedIntNode(IntNode):
+    # An oxython typed integer literal such as 10u8.
+    # The C code carries an explicit cast so that C sees the declared type.
+
+    def get_constant_c_result_code(self):
+        code = IntNode.get_constant_c_result_code(self)
+        if self.type.is_int:
+            code = "((%s)%s)" % (self.type.empty_declaration_code(), code)
+        return code
+
+
+class TypedFloatNode(FloatNode):
+    # An oxython typed float literal such as 2.5f32.
+
+    def get_constant_c_result_code(self):
+        code = FloatNode.get_constant_c_result_code(self)
+        if self.type.is_float:
+            if self.type is PyrexTypes.c_longdouble_type and code == self.value:
+                code += "L"
+            code = "((%s)%s)" % (self.type.empty_declaration_code(), code)
+        return code
+
+
 @cython.cfunc
 def _analyse_name_as_type(name, pos, env):
     ctype = PyrexTypes.parse_basic_type(name)
diff --git a/Cython/Compiler/Lexicon.py b/Cython/Compiler/Lexicon.py
index 8dc034417..5e13a22c1 100644
--- a/Cython/Compiler/Lexicon.py
+++ b/Cython/Compiler/Lexicon.py
@@ -58,6 +58,12 @@ def make_lexicon(oxython=False, rust_comments=False):
     intsuffix = (Opt(Any("Uu")) + Opt(Any("Ll")) + Opt(Any("Ll"))) | (Opt(Any("Ll")) + Opt(Any("Ll")) + Opt(Any("Uu")))
     intliteral = intconst + intsuffix
     fltconst = (decimal_fract + Opt(exponent)) | (decimal + exponent)
+    if oxython:
+        # Rust-style typed literals: 10u8, 1_000i64, 2.5f32, 1f64
+        int_type_suffix = Str("i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "isize", "usize")
+        float_type_suffix = Str("f32", "f64")
+        intliteral = intliteral | (intconst + int_type_suffix)
+        fltconst = fltconst | ((fltconst | decimal) + float_type_suffix)
     imagconst = (intconst | fltconst) + Any("jJ")
 
     # invalid combinations of prefixes are caught in p_string_literal
