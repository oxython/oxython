@@ -4462,6 +4478,8 @@ def p_oxython_item(s: PyrexScanner, pos, ctx, decorators):
 
     if decorators:
         allowed = (Nodes.CFuncDefNode, Nodes.CVarDefNode, Nodes.CClassDefNode)
+        if is_oxython_impl(node):
+            error(pos, "Decorators can only be followed by functions or classes")
