     s.next()
     module_path = []
     class_name = p_ident(s)
-    while s.sy == '.':
+    while s.sy == '.' or s.sy == '::':
         s.next()
         module_path.append(class_name)
         class_name = p_ident(s)
@@ -4787,7 +4932,10 @@ def p_c_class_definition(s: PyrexScanner, pos,  ctx):
             body_level = 'c_class_pxd'
         else:
             body_level = 'c_class'
-        doc, body = p_suite_with_docstring(s, Ctx(level=body_level))
+        if struct_fields:
+            doc, body = p_oxython_struct_fields(s, body_level)
+        else:
+            doc, body = p_suite_with_docstring(s, Ctx(level=body_level))
     else:
         s.expect_newline("Syntax error in C class definition")
         doc = None
@@ -4998,6 +5146,8 @@ def p_module(s: PyrexScanner, pxd, full_module_name, ctx=Ctx):
         # oxython: '//!' comments document the module
         doc = s.take_doc_comment(inner=True)
     body = p_statement_list(s, ctx(level=level), first_statement=True)
+    if s.oxython:
+        body = merge_oxython_impls(body, pxd)
     if s.sy != 'EOF':
         s.error("Syntax error in statement [%s,%s]" % (
             repr(s.sy), repr(s.systring)))
