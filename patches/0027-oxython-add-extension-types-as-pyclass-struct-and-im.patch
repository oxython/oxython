Subject: [PATCH] oxython: add extension types as #[pyclass] struct and impl


diff --git a/Cython/Compiler/Parsing.py b/Cython/Compiler/Parsing.py
index 154669325..94efd9b4a 100644
--- a/Cython/Compiler/Parsing.py
+++ b/Cython/Compiler/Parsing.py
@@ -4345,6 +4345,13 @@ def make_oxython_from_cimport(s: PyrexScanner, pos, module_path, level, imported
         relative_level=level, imported_names=imported_names)
 
 
+@cython.cfunc
+def is_pyclass_attribute(decorator) -> cython.bint:
+    # '#[pyclass]' marks a struct as a Python extension type
+    node = decorator.decorator
+    return node.is_name and node.name == 'pyclass'
+
+
 @cython.cfunc
