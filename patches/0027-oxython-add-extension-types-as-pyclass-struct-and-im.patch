@@ -4470,6 +4488,133 @@ def p_oxython_item(s: PyrexScanner, pos, ctx, decorators):
     return node
 
 
+@cython.cfunc
+def looking_at_extension_struct(s: PyrexScanner) -> cython.bint:
+    # 'struct mod::Name [object ...]': a qualified name or type options make an
+    # extension type, as in 'cdef extern class' / 'cdef public class'
+    saved = [(s.sy, s.systring, s.position())]
+    s.next()
+    qualified = False
+    if s.sy == 'IDENT':
+        saved.append((s.sy, s.systring, s.position()))
+        s.next()
+        while s.sy in ('::', '.'):
+            qualified = True
+            saved.append((s.sy, s.systring, s.position()))
+            s.next()
+            if s.sy != 'IDENT':
+                break
+            saved.append((s.sy, s.systring, s.position()))
+            s.next()
+    result = qualified or s.sy == '['
+    for sv in reversed(saved):
+        s.put_back(*sv)
+    return result
+
+
+def p_oxython_struct_fields(s: PyrexScanner, level):
+    # body of an extension type struct: '[pub | readonly] <C declaration>' lines
+    s.expect(':')
+    s.expect('NEWLINE')
+    s.expect_indent()
+    doc = p_doc_string(s)
+    pos = s.position()
+    stats = []
+    while s.sy not in ('DEDENT', 'EOF'):
+        if s.sy == 'pass':
+            s.next()
+            s.expect_newline("Expected a newline")
+            continue
+        field_pos = s.position()
+        field_doc = s.take_doc_comment() if s.rust_comments else None
+        if s.looking_at_keyword('fn') or s.sy == 'IDENT' and s.systring in ('const', 'static') and s.peek()[1] == 'fn':
+            p_oxython_fn(s, field_pos, Ctx(level=level))
+            error(field_pos, "Methods belong in an 'impl' block")
+            continue
+        visibility = 'private'
+        if s.looking_at_keyword('pub'):
+            s.next()
+            visibility = 'public'
+        elif s.looking_at_keyword('readonly'):
+            s.next()
+            visibility = 'readonly'
+        node = p_c_func_or_var_declaration(s, field_pos, Ctx(level=level, visibility=visibility))
+        if isinstance(node, Nodes.CFuncDefNode) or any(declares_function(d) for d in node.declarators):
+            error(field_pos, "Methods belong in an 'impl' block")
+            continue
+        if field_doc is not None:
+            node.doc = field_doc
+        stats.append(node)
+    s.expect_dedent()
+    return doc, Nodes.StatListNode(pos, stats=stats)
+
+
+def p_oxython_impl(s: PyrexScanner, pos, ctx):
+    # impl Name: <methods>     merged into the extension type 'Name'
+    if ctx.level not in ('module', 'module_pxd'):
+        error(pos, "impl block not allowed here")
+    s.next()  # 'impl'
+    name = p_ident(s)
+    level = 'c_class_pxd' if ctx.level == 'module_pxd' else 'c_class'
+    doc, body = p_suite_with_docstring(s, Ctx(level=level))
+    if not isinstance(body, Nodes.StatListNode):
+        body = Nodes.StatListNode(body.pos, stats=[body])
+    body.pos = pos
+    body.oxython_impl_name = name
+    body.oxython_impl_doc = doc
+    return body
+
+
+@cython.cfunc
+def is_oxython_impl(node) -> cython.bint:
+    return getattr(node, 'oxython_impl_name', None) is not None
+
+
+def merge_oxython_impls(body, in_pxd):
+    # Move the methods of 'impl Name:' blocks into the extension type 'Name'.
+    # Without a struct in this file, the impl implements a type declared in
+    # the module's .oxd file.
+    stats = body.stats if isinstance(body, Nodes.StatListNode) else [body]
+    if not any(is_oxython_impl(stat) for stat in stats):
+        return body
+    classes = {}
+    structs = set()
+    for stat in stats:
+        if isinstance(stat, Nodes.CClassDefNode) and not stat.module_name:
+            classes[stat.class_name] = stat
+        elif isinstance(stat, Nodes.CStructOrUnionDefNode):
+            structs.add(stat.name)
+    result = []
+    for stat in stats:
+        if not is_oxython_impl(stat):
+            result.append(stat)
+            continue
+        name = stat.oxython_impl_name
+        if name in structs:
+            error(stat.pos, "'impl %s' needs a '#[pyclass] struct %s'" % (name, name))
+            continue
+        cls = classes.get(name)
+        if cls is None:
+            cls = classes[name] = Nodes.CClassDefNode(
+                stat.pos, visibility='private', typedef_flag=False, api=False,
+                module_name=EncodedString(''), class_name=name, as_name=name,
+                bases=ExprNodes.TupleNode(stat.pos, args=[]),
+                objstruct_name=None, typeobj_name=None, check_size=None,
+                in_pxd=in_pxd, doc=None, body=None)
+            result.append(cls)
+        if cls.body is None:
+            cls.body = Nodes.StatListNode(stat.pos, stats=[])
+        elif not isinstance(cls.body, Nodes.StatListNode):
+            cls.body = Nodes.StatListNode(cls.body.pos, stats=[cls.body])
+        cls.body.stats.extend(stat.stats)
+        if stat.oxython_impl_doc and not cls.doc:
+            cls.doc = stat.oxython_impl_doc
+    if isinstance(body, Nodes.StatListNode):
+        body.stats = result
+        return body
+    return Nodes.StatListNode(body.pos, stats=result)
+
+
 @cython.cfunc
 def check_oxython_level(s: PyrexScanner, ctx, pos, what):
     if ctx.level not in _oxython_cdef_levels:
@@ -4750,12 +4895,12 @@ def p_class_statement(s: PyrexScanner, decorators):
 
 
 @cython.cfunc
-def p_c_class_definition(s: PyrexScanner, pos,  ctx):
-    # s.sy == 'class'
