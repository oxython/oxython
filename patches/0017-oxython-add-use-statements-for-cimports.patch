From: Rin Arakaki <rnarkkx@gmail.com>
Date: Mon, 12 Oct 2026 07:34:41 +0000
Subject: [PATCH] oxython: add use statements for cimports


diff --git a/Cython/Build/Dependencies.py b/Cython/Build/Dependencies.py
index 9bf211226..5b733c0ba 100644
--- a/Cython/Build/Dependencies.py
+++ b/Cython/Build/Dependencies.py
@@ -403,6 +403,67 @@ dependency_regex = re.compile(
     r"(?:^ [ \t\f]* cdef     [ \t\f]+ extern [ \t\f]+ from [ \t\f]+ ['\"] ([^'\"]+) ['\"] ) |"
     r"(?:^ [ \t\f]* include  [ \t\f]+ ['\"] ([^'\"]+) ['\"] )",
     re.MULTILINE | re.VERBOSE)
+oxython_use_regex = re.compile(r"^[ \t\f]*use[ \t\f]+", re.MULTILINE)
+
+
+def oxython_use_dependencies(source):
+    # Modules named by oxython 'use' trees, e.g. 'use a::{b::{c, d}, e}' gives
+    # 'a', 'a.b', 'a.b.c', 'a.b.d', 'a.e', like the equivalent cimports would.
+    modules = []
+    for m in oxython_use_regex.finditer(source):
+        # the statement ends at a newline outside braces
+        depth, end = 0, m.end()
+        while end < len(source):
+            c = source[end]
+            if c == '{':
+                depth += 1
+            elif c == '}':
+                depth -= 1
+            elif c == '\n' and depth <= 0:
+                break
+            end += 1
+        tokens = re.findall(r"::|[{},*]|\w+", source[m.end():end])
+        _collect_use_modules(tokens, 0, [], modules)
+    return modules
+
+
+def _collect_use_modules(tokens, i, prefix, modules):
+    # parse comma separated use trees starting at tokens[i]; returns the next index
+    while i < len(tokens):
+        path = list(prefix)
+        level = 0
+        while i < len(tokens) and tokens[i] == 'super' and not prefix:
+            level += 1
+            i += 2  # 'super' '::'
+        while i < len(tokens):
+            tok = tokens[i]
+            if tok == '{':
+                i = _collect_use_modules(tokens, i + 1, path, modules)
+                i += 1  # '}'
+                break
+            if tok in ('*', ',', '}') or tok == 'as':
+                break
+            if tok != 'self':
+                path.append(tok)
+            i += 1
+            if i < len(tokens) and tokens[i] == '::':
+                i += 1
+                continue
+            break
+        if path:
+            dotted = '.' * level + '.'.join(path)
+            modules.append(dotted)
+            if len(path) > 1:
+                modules.append('.' * level + '.'.join(path[:-1]))
+        while i < len(tokens) and tokens[i] not in (',', '}'):
+            i += 1  # skip '*', 'as name'
+        if i < len(tokens) and tokens[i] == ',':
+            i += 1
+            continue
+        return i
+    return i
+
+
 dependency_after_from_regex = re.compile(
     r"(?:^ [ \t\f]+ \( ([\w., \t\f]*) \) [ \t\f]* [#\n]) |"
     r"(?:^ [ \t\f]+    ([\w., \t\f]*)    [ \t\f]* [#\n])",
@@ -492,6 +553,8 @@ def parse_dependencies(source_filename):
     cimports = []
     includes = []
     externs  = []
+    if source_filename.endswith(('.oxy', '.oxd', '.oxi')):
+        cimports.extend(oxython_use_dependencies(source))
     for m in dependency_regex.finditer(source):
         pycimports_from, cimport_from, pycimports_list, cimport_list, extern, include = m.groups()
         if pycimports_from:
