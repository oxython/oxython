+def split_double_colon(s: PyrexScanner):
+    # The oxython lexicon reads '::' as one token. Inside slices it still
+    # means two colons, as in 'a[::2]' or 'double[:, ::1]'.
+    if s.sy == '::':
+        pos = s.position()
+        s.sy = s.systring = ':'
+        s.last_token_position_tuple = (pos[0], pos[1], pos[2] + 1)
+        s.put_back(':', ':', pos)
+
+
 @cython.cfunc
 def p_slice_element(s: PyrexScanner, follow_set):
     # Simple expression which may be missing iff
@@ -3034,12 +3046,12 @@ def is_memoryviewslice_access(s: PyrexScanner) -> cython.bint:
     saved = [(s.sy, s.systring, s.position())]
     s.next()
     retval = False
-    if s.systring == ':':
+    if s.systring in (':', '::'):
         retval = True
     elif s.sy == 'INT':
         saved.append((s.sy, s.systring, s.position()))
         s.next()
-        if s.sy == ':':
+        if s.sy in (':', '::'):
             retval = True
 
     for sv in saved[::-1]:
@@ -4032,9 +4044,83 @@ def p_oxython_statement(s: PyrexScanner, ctx, pos, decorators):
     # Returns None, consuming nothing, if the statement is not one of them.
     if looking_at_oxython_item(s, ctx):
         return p_oxython_item(s, pos, ctx, decorators)
+    if s.looking_at_keyword('use') and s.peek()[0] == 'IDENT':
+        if decorators:
+            error(pos, "Decorators can only be followed by functions or classes")
+        return p_oxython_use(s, pos)
     return None
 
 
+def p_oxython_use(s: PyrexScanner, pos):
+    # use <tree>[, <tree>...] where, as in Rust,
+    #   tree:  [super::]* name (:: name)* [:: (* | {tree, ...})] [as name]
+    # 'use a' is 'cimport a'; 'use a::b::c' is 'from a.b cimport c';
+    # 'use a::{self, b}' is 'from . cimport a' plus 'from a cimport b'.
+    s.next()  # 'use'
+    stats = []
+    while True:
+        level = 0
+        while s.looking_at_keyword('super'):
+            level += 1
+            s.next()
+            s.expect('::')
+        p_oxython_use_tree(s, [], level, stats)
+        if s.sy != ',':
+            break
+        s.next()
+    s.expect_newline("Expected a newline", ignore_semicolon=True)
+    if len(stats) == 1:
+        return stats[0]
+    return Nodes.StatListNode(pos, stats=stats)
+
+
+def p_oxython_use_tree(s: PyrexScanner, prefix, level, stats):
+    pos = s.position()
+    path = list(prefix)
+    while True:
+        if s.sy == '{':
+            s.next()
+            while s.sy != '}':
+                p_oxython_use_tree(s, path, level, stats)
+                if s.sy != ',':
+                    break
+                s.next()
+            s.expect('}')
+            return
+        if s.sy == '*':
+            if not path:
+                s.error("Expected a module before '*'")
+            s.next()
+            stats.append(make_oxython_from_cimport(
+                s, pos, path, level, [(pos, s.context.intern_ustring('*'), None)]))
+            return
+        name_pos = s.position()
+        name = p_ident(s)
+        if name == 'self' and prefix and len(path) == len(prefix):
+            name = None  # 'a::{self}' names the module 'a' itself
+        else:
+            path.append(name)
+        if name is not None and s.sy == '::':
+            s.next()
+            continue
+        break
+    as_name = p_as_name(s)
+    if len(path) == 1 and not level:
+        stats.append(Nodes.CImportStatNode(
+            pos, module_name=path[0], as_name=as_name,
+            is_absolute=Future.absolute_import in s.context.future_directives))
+    else:
+        stats.append(make_oxython_from_cimport(s, pos, path[:-1], level, [(name_pos, path[-1], as_name)]))
+
+
+def make_oxython_from_cimport(s: PyrexScanner, pos, module_path, level, imported_names):
+    if not level:
+        level = 0 if Future.absolute_import in s.context.future_directives else None
+    return Nodes.FromCImportStatNode(
+        pos, module_name=s.context.intern_ustring('.'.join(module_path)),
+        relative_level=level, imported_names=imported_names)
+
+
 # words that can start an oxython item
 _oxython_item_words = cython.declare(frozenset, frozenset((
     'fn', 'let', 'static', 'const', 'type', 'struct', 'union', 'enum', 'packed')))
