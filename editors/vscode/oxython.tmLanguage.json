{
    "scopeName": "source.oxython",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "attributes": {
            "name": "meta.attribute.oxython",
            "begin": "#!?\\[",
            "end": "\\]",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.attribute.oxython"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.attribute.oxython"
                }
            },
            "patterns": [
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#operators"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.oxython",
                    "match": "//[/!].*$"
                },
                {
                    "name": "comment.line.double-slash.oxython",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.oxython",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.oxython",
                    "begin": "(?i)\\b[rbfuct]{0,2}(\"\"\"|''')",
                    "end": "\\1"
                },
                {
                    "name": "string.quoted.double.oxython",
                    "begin": "(?i)\\b[rbfuct]{0,2}\"",
                    "end": "\"|$",
                    "patterns": [
                        {
                            "name": "constant.character.escape.oxython",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.oxython",
                    "begin": "(?i)\\b[rbfuct]{0,2}'",
                    "end": "'|$",
                    "patterns": [
                        {
                            "name": "constant.character.escape.oxython",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.oxython",
                    "match": "\\b(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?)(i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|[uUlL]{0,3}|[jJ])?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.oxython",
                    "match": "\\b(fn|let|static|const|type|struct|union|enum|packed|impl|pub|extern|api|readonly|use|auto|mut|cpdef|class|cppclass|fused|include|nogil|noexcept|inline)\\b"
                },
                {
                    "name": "keyword.control.oxython",
                    "match": "\\b(loop|if|elif|else|for|while|break|continue|return|yield|try|except|finally|raise|with|as|import|pass|del|global|nonlocal|assert|async|await|match|case|lambda)\\b"
                },
                {
                    "name": "keyword.operator.word.oxython",
                    "match": "\\b(and|or|not|in|is|sizeof|new)\\b"
                },
                {
                    "name": "variable.language.oxython",
                    "match": "\\b(self|super)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.builtin.oxython",
                    "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|c64|c128|u2|c_char|c_schar|c_uchar|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_float|c_double|c_longdouble|void|object)\\b"
                },
                {
                    "name": "storage.modifier.reference.oxython",
                    "match": "\\br?&(mut\\b)?|&&"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.oxython",
                    "match": "\\b(true|false|True|False|None|NULL)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.oxython",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.range.oxython",
                    "match": "\\.\\.=?"
                },
                {
                    "name": "punctuation.separator.path.oxython",
                    "match": "::"
                }
            ]
        }
    }
}
