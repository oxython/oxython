// mode: run
// tag: oxython

use libc::stdio

struct Point:
    f64 x
    f64 y

union Number:
    i64 i
    f64 f

struct Line:
    Point start
    Point end

fn f64 length2(Point p):
    return p.x * p.x + p.y * p.y

/// >>> test_struct_literals()
/// (1.0, 2.0, 25.0)
fn test_struct_literals():
    let Point p = Point { x = 1, y = 2 }
    return p.x, p.y, length2(Point { x = 3, y = 4 })

/// >>> test_nested()
/// {'start': {'x': 0.0, 'y': 0.0}, 'end': {'x': 1.0, 'y': 1.0}}
fn test_nested():
    let Line line = Line {
        start = Point { x = 0, y = 0 },
        end = Point { x = 1, y = 1 },
    }
    return line

/// A union literal sets exactly one field.
///
/// >>> test_union()
/// 7
fn test_union():
    let Number n = Number { i = 7 }
    return n.i

/// >>> test_sets_and_dicts_unchanged()
/// ({1, 2}, {'a': 1}, [{3}])
fn test_sets_and_dicts_unchanged():
    s = {1, 2}
    d = {"a": 1}
    return s, d, [{3}]
