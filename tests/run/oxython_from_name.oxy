// mode: run
// tag: oxython

from os import path

/// 'from' is an ordinary name.
///
/// >>> span(2, 5)
/// [2, 3, 4]
fn span(from, to):
    let auto start = from
    return list(start..to)

/// It keeps its meaning in 'yield from', 'raise ... from' and imports.
///
/// >>> list(keyword_uses([1, 2]))
/// [1, 2, '/']
fn keyword_uses(items):
    yield from items
    try:
        raise ValueError() from None
    except ValueError:
        pass
    yield path.sep
