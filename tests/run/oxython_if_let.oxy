// mode: run
// tag: oxython

class Point:
    __match_args__ = ("x", "y")

    fn __init__(self, x, y):
        self.x = x
        self.y = y

/// 'if let' runs the body when the pattern matches and binds its names.
///
/// >>> sum_pair([1, 2])
/// 3
/// >>> sum_pair([1, 2, 3])
/// 'no pair'
/// >>> sum_pair("ab")
/// 'no pair'
fn sum_pair(value):
    if let [a, b] = value:
        return a + b
    else:
        return "no pair"

/// 'elif' may mix plain conditions and further 'let' patterns.
///
/// >>> describe(Point(0, 5))
/// 'on the y axis at 5'
/// >>> describe({"name": "ox"})
/// 'named ox'
/// >>> describe(7)
/// 'positive'
/// >>> describe(-1)
/// 'other'
fn describe(value):
    if let Point(0, y) = value:
        return f"on the y axis at {y}"
    elif let {"name": name} = value:
        return f"named {name}"
    elif isinstance(value, int) and value > 0:
        return "positive"
    else:
        return "other"

/// >>> plain_if_then_let(None)
/// 'none'
/// >>> plain_if_then_let((1, "x"))
/// 'x'
/// >>> plain_if_then_let(3)
fn plain_if_then_let(value):
    if value is None:
        return "none"
    elif let (1, label) = value:
        return label

/// >>> no_else([9])
/// 9
/// >>> no_else([])
fn no_else(value):
    if let [only] = value:
        return only

/// 'while let' loops while the pattern keeps matching.
///
/// >>> drain([[1, 2], [3, 4], "stop", [5, 6]])
/// [3, 7]
fn drain(list stack):
    sums = []
    while let [a, b] = stack.pop(0):
        sums.append(a + b)
    return sums

/// 'continue' and 'break' refer to the 'while let' loop.
///
/// >>> skip_and_stop(iter([(1, 0), (2, 1), (3, 0), (4, 9), None, (5, 0)]))
/// [1, 3]
fn skip_and_stop(values):
    seen = []
    while let (n, flag) = next(values):
        if flag == 9:
            break
        if flag:
            continue
        seen.append(n)
    return seen

/// >>> literal_patterns(404), literal_patterns(200)
/// ('missing', 'ok')
fn literal_patterns(code):
    if let 404 | 410 = code:
        return "missing"
    return "ok"

/// >>> let_items_still_work()
/// 3
fn let_items_still_work():
    let i32 x = 1
    let auto y = 2
    return x + y
