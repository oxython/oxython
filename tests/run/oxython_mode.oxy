// mode: run
// tag: oxython

//comments without a space after the hash still work
use cython
use cython::view::array as cvarray

/// Slices with '::' keep their Python meaning.
///
/// >>> slices(list(range(10)))
/// ([0, 2, 4, 6, 8], [1, 4, 7], [9, 8, 7, 6, 5, 4, 3, 2, 1, 0], [8, 6])
fn slices(seq):
    return seq[::2], seq[1::3], seq[ :: -1], seq[8:5:-2]

/// >>> memoryview_axes()
/// 4.5
fn memoryview_axes():
    let double[:, ::1] m = cvarray(shape=(2, 3), itemsize=sizeof(double), format="d")
    m[1, 2] = 4.5
    return m[1, 2]

/// Raw identifiers let contextual keywords be used as names.
///
/// >>> raw_identifiers(1)
/// (1, 2, 3)
fn raw_identifiers(r#fn, r#let=2):
    r#use = r#fn + r#let
    return r#fn, r#let, r#use

/// >>> ellipsis_still_works()
/// Ellipsis
fn ellipsis_still_works():
    return ...
